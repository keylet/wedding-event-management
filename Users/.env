DB_HOST=mysql-db
DB_USER=some_user   # Aquí puedes poner un usuario diferente a "root"
DB_PASSWORD=rootpassword
DB_NAME=users_db
DB_PORT=3306
JWT_SECRET=my_super_secret_key

MYSQL_ROOT_PASSWORD=rootpassword # Configura la contraseña del root correctamente
MYSQL_ALLOW_EMPTY_PASSWORD=no   # Si no quieres que la contraseña esté vacía
